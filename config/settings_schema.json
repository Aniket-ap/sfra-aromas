[
  {
    "name": "theme_info",
    "theme_name": "SFRA Aromas",
    "theme_version": "1.0.0",
    "theme_author": "SFRA Aromas",
    "theme_documentation_url": "https://help.shopify.com/",
    "theme_support_url": "https://help.shopify.com/"
  },
  {
    "name": "Logo & favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 60,
        "max": 320,
        "step": 10,
        "unit": "px",
        "label": "Logo width (desktop)",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Square image, at least 32 x 32px"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_bg",
        "label": "Page background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_alt_bg",
        "label": "Alternate section background",
        "default": "#f3f3f3"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Main text",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted / secondary text",
        "default": "#6b6b6b"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (buttons, dark sections)",
        "default": "#111111"
      },
      {
        "type": "color",
        "id": "color_accent_text",
        "label": "Text on accent",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders & lines",
        "default": "#e3e3e3"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "label": "Heading font",
        "default": "assistant_n6"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Body font",
        "default": "assistant_n4"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading size scale",
        "default": 100
      },
      {
        "type": "checkbox",
        "id": "heading_uppercase",
        "label": "Uppercase headings",
        "default": true
      }
    ]
  },
  {
    "name": "Layout & style",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1000,
        "max": 1600,
        "step": 100,
        "unit": "px",
        "label": "Maximum page width",
        "default": 1300
      },
      {
        "type": "range",
        "id": "button_radius",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "label": "Button corner radius",
        "default": 0
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Card corner radius",
        "default": 0
      }
    ]
  },
  {
    "name": "Contact details & WhatsApp",
    "settings": [
      {
        "type": "text",
        "id": "contact_email",
        "label": "Email",
        "default": "info@sfraaromas.com"
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Phone / WhatsApp display number",
        "default": "9550850777"
      },
      {
        "type": "text",
        "id": "contact_whatsapp_number",
        "label": "WhatsApp number with country code",
        "default": "919550850777"
      },
      {
        "type": "text",
        "id": "contact_address_label",
        "label": "Address heading",
        "default": "Registered office"
      },
      {
        "type": "text",
        "id": "contact_gst",
        "label": "GST number",
        "default": "36ABQCS9242N1ZE"
      },
      {
        "type": "text",
        "id": "contact_hours_label",
        "label": "Hours heading",
        "default": "Business hours"
      },
      {
        "type": "text",
        "id": "whatsapp_label",
        "label": "WhatsApp button label",
        "default": "Chat on WhatsApp"
      },
      {
        "type": "textarea",
        "id": "contact_address",
        "label": "Address",
        "default": "32-124, HAL COLONY,\nJEEDIMETLA\nHYDERABAD - 500055"
      },
      {
        "type": "textarea",
        "id": "contact_hours",
        "label": "Opening hours",
        "default": "9 AM - 5 PM\nSunday closed"
      },
      {
        "type": "textarea",
        "id": "whatsapp_message",
        "label": "Prefilled WhatsApp message",
        "default": "Hello SFRA Aromas, I would like to know more about your products."
      },
      {
        "type": "checkbox",
        "id": "show_floating_whatsapp",
        "label": "Show floating WhatsApp button",
        "default": true
      },
      {
        "type": "select",
        "id": "whatsapp_position",
        "label": "Floating button position",
        "options": [
          {
            "value": "right",
            "label": "Right"
          },
          {
            "value": "left",
            "label": "Left"
          }
        ],
        "default": "right"
      },
      {
        "type": "color",
        "id": "whatsapp_color",
        "label": "WhatsApp button background",
        "default": "#128c7e"
      },
      {
        "type": "color",
        "id": "whatsapp_text_color",
        "label": "WhatsApp button text",
        "default": "#ffffff"
      }
    ]
  },
  {
    "name": "Social media",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook"
      },
      {
        "type": "url",
        "id": "social_linkedin",
        "label": "LinkedIn"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube"
      },
      {
        "type": "url",
        "id": "social_x",
        "label": "X (Twitter)"
      },
      {
        "type": "url",
        "id": "social_pinterest",
        "label": "Pinterest"
      }
    ]
  }
]

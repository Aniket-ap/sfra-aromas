<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    <style>
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ settings.type_heading_font | font_face: font_display: 'swap' }}
      :root {
        --color-bg: {{ settings.color_bg }};
        --color-text: {{ settings.color_text }};
        --color-muted: {{ settings.color_muted }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-text: {{ settings.color_accent_text }};
        --color-alt-bg: {{ settings.color_alt_bg }};
        --color-border: {{ settings.color_border }};
        --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --font-body-weight: {{ settings.type_body_font.weight }};
        --font-heading: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
        --font-heading-weight: {{ settings.type_heading_font.weight }};
        --heading-scale: {{ settings.heading_scale | divided_by: 100.0 }};
        --heading-transform: {% if settings.heading_uppercase %}uppercase{% else %}none{% endif %};
        --page-width: {{ settings.page_width }}px;
        --btn-radius: {{ settings.button_radius }}px;
        --card-radius: {{ settings.card_radius }}px;
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>

{%- assign menu = linklists[section.settings.menu] -%}

<header class="site-header{% if section.settings.sticky %} is-sticky{% endif %}" data-header>
  <div class="container header__inner">
    <button type="button" class="header__toggle" aria-expanded="false" aria-controls="HeaderNav" data-nav-toggle aria-label="Menu">
      <span class="header__toggle-open">{% render 'icon', name: 'menu', size: 24 %}</span>
      <span class="header__toggle-close">{% render 'icon', name: 'close', size: 24 %}</span>
    </button>

    <a href="{{ routes.root_url }}" class="header__logo" aria-label="{{ shop.name | escape }}" style="--logo-width: {{ settings.logo_width }}px;">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 640 | image_tag: width: settings.logo_width, alt: shop.name, loading: 'eager', class: 'header__logo-img' }}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="header__nav" id="HeaderNav" aria-label="Main menu" data-nav>
      <ul class="header__menu">
        {%- if menu != blank and menu.links.size > 0 -%}
          {%- assign menu_prefix = 'HeaderMenu-' | append: section.id -%}
          {% render 'navigation-links', links: menu.links, variant: 'header', prefix: menu_prefix %}
        {%- else -%}
          <li><a href="{{ routes.root_url }}">Home</a></li>
          <li><a href="{{ routes.all_products_collection_url }}">Shop</a></li>
          <li><a href="/pages/aromatherapy">Aromatheory</a></li>
          <li><a href="/pages/contact">Contact Us</a></li>
        {%- endif -%}
      </ul>
    </nav>

    <div class="header__icons">
      {%- if section.settings.show_search -%}
        <a href="{{ routes.search_url }}" class="header__icon header__search-toggle" aria-label="Search" aria-haspopup="dialog" aria-controls="HeaderSearchPanel-{{ section.id }}" data-search-open>
          {% render 'icon', name: 'search', size: 22 %}
        </a>
        <dialog class="search-modal" id="HeaderSearchPanel-{{ section.id }}" aria-label="{{ section.settings.search_heading | default: 'Search the store' | escape }}" data-search-modal data-search-url="{{ routes.search_url }}">
          <form action="{{ routes.search_url }}" method="get" role="search" class="search-modal__form">
            <span class="search-modal__icon">{% render 'icon', name: 'search', size: 22 %}</span>
            <label class="visually-hidden" for="HeaderSearch-{{ section.id }}">Search products</label>
            <input type="search" id="HeaderSearch-{{ section.id }}" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder | escape }}" autocomplete="off" required data-search-input>
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
            <button type="button" class="search-modal__close" aria-label="Close search" data-search-close>{% render 'icon', name: 'close', size: 20 %}</button>
          </form>
          <div class="search-modal__body">
            <p class="search-modal__label" data-search-label>Explore products</p>
            <p class="visually-hidden" role="status" aria-live="polite" data-search-status></p>
            <ul class="search-modal__products" data-search-products>
              {%- assign search_collection = section.settings.search_collection | default: collections.all -%}
              {%- for product in search_collection.products limit: 50 -%}
                <li><a class="search-modal__product" href="{{ product.url }}">
                  <span class="search-modal__thumbnail">
                    {%- if product.featured_image -%}
                      {{ product.featured_image | image_url: width: 100 | image_tag: loading: 'lazy', width: 48, height: 48, alt: '' }}
                    {%- else -%}{% render 'icon', name: 'search', size: 20 %}{%- endif -%}
                  </span>
                  <span class="search-modal__name">{{ product.title | escape }}</span>
                  <span class="search-modal__type">{{ product.type | escape }}</span>
                </a></li>
              {%- else -%}
                <li class="search-modal__message">Search to discover our products.</li>
              {%- endfor -%}
            </ul>
          </div>
          <a class="search-modal__all" href="{{ routes.all_products_collection_url }}" data-search-all>View all products {% render 'icon', name: 'arrow', size: 18 %}</a>
        </dialog>
      {%- endif -%}
      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="header__icon" aria-label="Account">{% render 'icon', name: 'user', size: 22 %}</a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="header__icon header__cart" aria-label="Cart">
        {% render 'icon', name: 'cart', size: 22 %}
        <span class="cart-count{% if cart.item_count == 0 %} is-empty{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Create a menu with Home, Shop, Aromatheory and Contact Us under Content → Menus."
    },
    { "type": "checkbox", "id": "sticky", "label": "Sticky header", "default": true },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "collection", "id": "search_collection", "label": "Search preview collection", "info": "Leave empty to preview all products. Shows up to 50; View all opens the full catalog." },
    { "type": "text", "id": "search_heading", "label": "Search heading", "default": "Find your signature scent" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search diffusers, fragrance oils and more" },
    { "type": "checkbox", "id": "show_account", "label": "Show account icon", "default": false }
  ]
}
{% endschema %}

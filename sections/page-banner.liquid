{%- liquid
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}
<section class="page-banner{% if has_image %} page-banner--image{% endif %} page-banner--{{ section.settings.align }}" style="--banner-h: {{ section.settings.height }}px;">
  {%- if has_image -%}
    <div class="page-banner__media">
      {%- assign img_alt = section.settings.image.alt | default: section.settings.heading -%}{{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', alt: img_alt }}
      <div class="page-banner__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
    </div>
  {%- endif -%}
  <div class="container page-banner__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="page-banner__title">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="page-banner__text">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--solid">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Image overlay opacity", "default": 50 },
    { "type": "range", "id": "height", "min": 200, "max": 600, "step": 20, "unit": "px", "label": "Minimum height", "default": 320 },
    { "type": "select", "id": "align", "label": "Alignment", "options": [
      { "value": "center", "label": "Center" },
      { "value": "left", "label": "Left" }
    ], "default": "center" },
    { "type": "text", "id": "eyebrow", "label": "Small heading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Page title" },
    { "type": "textarea", "id": "text", "label": "Subheading" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Page banner" }]
}
{% endschema %}

<section class="section bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="split split--{{ section.settings.image_position }} split--v-{{ section.settings.vertical_align }}">
      <div class="split__media{% if section.settings.contain_image %} is-contain{% endif %}">
        {%- if section.settings.image != blank -%}
          {%- assign img_alt = section.settings.image.alt | default: shop.name -%}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw', class: 'split__img', alt: img_alt }}
        {%- elsif settings.logo != blank -%}
          {{ settings.logo | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 50vw, 100vw', class: 'split__img split__img--logo', alt: shop.name }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endif -%}
      </div>

      <div class="split__content">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="split__title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.quote != blank -%}
          <blockquote class="split__quote">{{ section.settings.quote }}</blockquote>
        {%- endif -%}
        {%- if section.settings.content != blank -%}
          <div class="rte split__text">{{ section.settings.content }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="text-link">
            {{ section.settings.button_label }} {% render 'icon', name: 'arrow', size: 16 %}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image + content (About)",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use your theme logo." },
    { "type": "checkbox", "id": "contain_image", "label": "Show full image without cropping (good for logos)", "default": true },
    { "type": "select", "id": "image_position", "label": "Image position (desktop)", "options": [
      { "value": "left", "label": "Left" },
      { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "select", "id": "vertical_align", "label": "Vertical alignment", "options": [
      { "value": "start", "label": "Top" },
      { "value": "center", "label": "Middle" }
    ], "default": "center" },
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Clean Scent Technology" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "About SFRA Aromas" },
    { "type": "textarea", "id": "quote", "label": "Quote (optional)", "default": "“Fragrance is more than an accessory — it's an identity. Clean scent technology that never compromises on quality, safety, or sustainability.”" },
    { "type": "richtext", "id": "content", "label": "Text", "default": "<p>At SFRA Aromas, we believe fragrance is more than an accessory — it's an identity. A scent can turn a lobby into a memory, a spa into a sanctuary, a car into a retreat. That's why we've built our entire range around one principle: <strong>clean scent technology that never compromises on quality, safety, or sustainability.</strong></p><p>Every SFRA diffuser is engineered to run waterless, using advanced nebulizing and cold-air diffusion technology that preserves the integrity of pure fragrance oils without dilution, heat, or moisture. The result is a truer, longer-lasting scent throw — with none of the environmental waste associated with water-based or aerosol systems.</p>" },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Discover our technology" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "background", "label": "Background", "options": [
      { "value": "default", "label": "White" },
      { "value": "alt", "label": "Light gray" },
      { "value": "dark", "label": "Black" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "presets": [{ "name": "Image + content (About)" }]
}
{% endschema %}

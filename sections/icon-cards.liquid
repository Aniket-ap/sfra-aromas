<section class="section bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.subheading, align: 'center' %}

    <div class="card-grid card-grid--stretch" style="--cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <div class="info-card info-card--outline" {{ block.shopify_attributes }}>
          <div class="info-card__head">
            <span class="info-card__icon">
              {%- if block.settings.icon_image != blank -%}
                {{ block.settings.icon_image | image_url: width: 96 | image_tag: width: 24, height: 24, loading: 'lazy', alt: '' }}
              {%- else -%}
                {% render 'icon', name: block.settings.icon, size: 22 %}
              {%- endif -%}
            </span>
            {%- if block.settings.title != blank -%}<h3 class="info-card__title info-card__title--inline">{{ block.settings.title }}</h3>{%- endif -%}
          </div>
          {%- if block.settings.text != blank -%}<p class="info-card__text">{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="info-card__link" aria-label="{{ block.settings.title | escape }}"></a>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Icon cards (Who we serve)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Spaces & Environments" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Who We Serve" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Engineered ambient scent diffusion for environments where sensory impressions define the experience." },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }], "default": "4" },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "background", "label": "Background", "options": [
      { "value": "default", "label": "White" },
      { "value": "alt", "label": "Light gray" },
      { "value": "dark", "label": "Black" }
    ], "default": "default" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "options": [
          { "value": "hotel", "label": "Hotel" },
          { "value": "bank", "label": "Bank" },
          { "value": "spa", "label": "Spa / salon" },
          { "value": "car", "label": "Car" },
          { "value": "hospital", "label": "Hospital" },
          { "value": "cafe", "label": "Café" },
          { "value": "studio", "label": "Studio / creative" },
          { "value": "home", "label": "Home" },
          { "value": "leaf", "label": "Leaf" },
          { "value": "shield", "label": "Shield" },
          { "value": "droplet", "label": "Droplet" },
          { "value": "star", "label": "Star" }
        ], "default": "hotel" },
        { "type": "image_picker", "id": "icon_image", "label": "Custom icon image (overrides icon)", "info": "Small square image, e.g. 96 x 96px" },
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this space or audience." },
        { "type": "url", "id": "link", "label": "Link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon cards (Who we serve)",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}

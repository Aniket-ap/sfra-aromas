<section class="section" style="--pt: 96px; --pb: 96px;">
  <div class="container container--narrow empty-state">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 600 | image_tag: width: settings.logo_width, alt: shop.name, class: 'password__logo', style: 'margin-inline:auto;margin-bottom:32px;' }}
    {%- else -%}
      <p class="eyebrow">{{ shop.name }}</p>
    {%- endif -%}
    <h1 class="section-heading__title">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <div class="rte">{{ shop.password_message }}</div>
    {%- endif -%}

    {%- form 'storefront_password', class: 'search-form' -%}
      {{ form.errors | default_errors }}
      <input type="password" name="password" placeholder="Enter store password" aria-label="Password" required>
      <button type="submit" class="btn btn--solid">Enter</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }
  ]
}
{% endschema %}

{%- liquid
  assign suggestion_collection = section.settings.collection
  if suggestion_collection == blank
    assign suggestion_collection = product.collections.first
  endif
  if suggestion_collection == blank
    assign suggestion_collection = collections.all
  endif
  assign suggested_products = suggestion_collection.products
  if section.settings.products != blank
    assign suggested_products = section.settings.products
  endif
  assign shown = 0
-%}
{%- capture suggestion_cards -%}
  {%- for suggested_product in suggested_products -%}
    {%- if suggested_product.id == product.id -%}{%- continue -%}{%- endif -%}
    {%- if section.settings.available_only and suggested_product.available == false -%}{%- continue -%}{%- endif -%}
    {% render 'product-card', product: suggested_product %}
    {%- assign shown = shown | plus: 1 -%}
    {%- if shown >= section.settings.products_to_show -%}{%- break -%}{%- endif -%}
  {%- endfor -%}
{%- endcapture -%}
{%- if section.settings.enabled and shown > 0 -%}
  <section class="section bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
    <div class="container">
      {% render 'section-heading', heading: section.settings.heading, text: section.settings.subheading, align: section.settings.heading_align %}
      <div class="product-grid" style="--cols: {{ section.settings.columns }}; --cols-mobile: {{ section.settings.columns_small }};">
        {{ suggestion_cards }}
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="section container"><p>Add products or select a collection in the Product suggestions settings to show suggestions. The current product is always excluded.</p></div>
{%- endif -%}

{% schema %}
{
  "name": "Product suggestions",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show suggestions", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "select", "id": "heading_align", "label": "Heading alignment", "options": [{ "value": "center", "label": "Center" }, { "value": "left", "label": "Left" }], "default": "center" },
    { "type": "product_list", "id": "products", "label": "Hand-picked products", "limit": 12, "info": "Optional. Overrides the collection below. The current product is excluded." },
    { "type": "collection", "id": "collection", "label": "Suggestion collection", "info": "If empty, uses the current product's first collection, or all products if it has no collection." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "checkbox", "id": "available_only", "label": "Hide sold-out products", "default": false },
    { "type": "select", "id": "columns", "label": "Desktop columns", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "select", "id": "columns_small", "label": "Mobile columns", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "select", "id": "background", "label": "Background", "options": [{ "value": "default", "label": "White" }, { "value": "alt", "label": "Light gray" }, { "value": "dark", "label": "Black" }], "default": "default" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 }
  ],
  "presets": [{ "name": "Product suggestions" }]
}
{% endschema %}

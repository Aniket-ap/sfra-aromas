<section class="section exclusive-oils" style="--pt: 40px; --pb: 64px; --oil-image-size: {{ section.settings.image_size | default: 220 }}px;" data-oil-quotes>
  <div class="container">
    <div class="section-heading section-heading--center">
      <h1 class="section-heading__title">{{ section.settings.heading | default: collection.title | escape }}</h1>
      <div class="rte section-heading__text">{{ section.settings.intro }}</div>
    </div>
    <div class="exclusive-oils__grid">
      {% for block in section.blocks %}
        <article class="exclusive-oils__card" {{ block.shopify_attributes }}>
          <div class="exclusive-oils__image">
            {% if block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '220, 440, 800', sizes: '(max-width: 749px) 220px, 360px', alt: block.settings.title }}
            {% else %}
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </div>
          <h2 class="exclusive-oils__title">{{ block.settings.title | escape }}</h2>
          <div class="exclusive-oils__notes rte">{{ block.settings.notes }}</div>
          <div class="exclusive-oils__action">
            <p class="exclusive-oils__pricing">{{ section.settings.price_label | escape }}</p>
            <a href="#OilQuoteForm-{{ section.id }}" class="btn btn--solid btn--block" data-oil-quote-open data-fragrance="{{ block.id }}" aria-haspopup="dialog" aria-controls="OilQuoteModal-{{ section.id }}">{{ section.settings.quote_label | escape }}</a>
          </div>
        </article>
      {% endfor %}
    </div>
    <div data-oil-form-host class="exclusive-oils__fallback">
      {% assign form_id = 'OilQuoteForm-' | append: section.id %}
      {% form 'contact', id: form_id, class: 'exclusive-oils__form' %}
        <h2 id="OilQuoteHeading-{{ section.id }}" class="exclusive-oils__modal-heading">{{ section.settings.quote_label | escape }}</h2>
        {% if form.posted_successfully? %}
          <p class="form-message form-message--success" role="status" tabindex="-1" data-oil-feedback>{{ section.settings.success_message | escape }}</p>
        {% else %}
          {% if form.errors %}<div class="form-message form-message--error" role="alert" tabindex="-1" data-oil-feedback>{{ form.errors | default_errors }}</div>{% endif %}
          <input type="hidden" name="contact[Enquiry type]" value="Exclusive aroma oil quote">
          <div class="field">
            <label for="{{ form_id }}-fragrance">Fragrance *</label>
            <div class="select-wrap exclusive-oils__select">
            <select id="{{ form_id }}-fragrance" name="contact[Fragrance]" required data-oil-fragrance>
              {% for block in section.blocks %}<option value="{{ block.settings.title | escape }}" data-block-id="{{ block.id }}"{% if form['Fragrance'] == block.settings.title %} selected{% endif %}>{{ block.settings.title | escape }}</option>{% endfor %}
            </select>
            {% render 'icon', name: 'chevron-down', size: 16 %}
            </div>
          </div>
          <div class="field">
            <label for="{{ form_id }}-name">Full name *</label>
            <input id="{{ form_id }}-name" type="text" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name" required>
          </div>
          <div class="exclusive-oils__contact-row">
          <div class="field">
            <label for="{{ form_id }}-email">Email *</label>
            <input id="{{ form_id }}-email" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required>
          </div>
          <div class="field">
            <label for="{{ form_id }}-phone">Phone</label>
            <input id="{{ form_id }}-phone" type="tel" name="contact[phone]" value="{{ form.phone | escape }}" autocomplete="tel">
          </div>
          </div>
          <div class="field">
            <label for="{{ form_id }}-message">Requirement / quantity *</label>
            <textarea id="{{ form_id }}-message" name="contact[body]" rows="2" required>{{ form.body | escape }}</textarea>
          </div>
          <button type="submit" class="btn btn--solid btn--block">{{ section.settings.submit_label | escape }}</button>
        {% endif %}
      {% endform %}
    </div>
    <dialog id="OilQuoteModal-{{ section.id }}" class="oil-quote-modal" aria-labelledby="OilQuoteHeading-{{ section.id }}" data-oil-dialog>
      <button type="button" class="oil-quote-modal__close" aria-label="Close quote form" data-oil-close>{% render 'icon', name: 'close', size: 22 %}</button>
      <div data-oil-modal-content></div>
    </dialog>
  </div>
</section>

{% schema %}
{
  "name": "Exclusive aroma oils",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Exclusive Aroma Oils"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Discover our exclusive fragrances. Contact us for pricing and a recommendation for your space.</p>"
    },
    {
      "type": "range",
      "id": "image_size",
      "label": "Product image size",
      "min": 120,
      "max": 360,
      "step": 20,
      "unit": "px",
      "default": 220
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Pricing message",
      "default": "Prices on request"
    },
    {
      "type": "text",
      "id": "quote_label",
      "label": "Quote button label",
      "default": "Request a quote"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Send enquiry"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you. Your quote request has been sent. Our team will contact you shortly."
    },
    {
      "type": "paragraph",
      "content": "Quote enquiries are sent by Shopify to the Sender email in Settings > Notifications. Set and verify that address, then test delivery (including spam). This native contact form does not create a saved-enquiries dashboard."
    }
  ],
  "blocks": [
    {
      "type": "fragrance",
      "name": "Fragrance",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name",
          "default": "Fragrance name"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Product image"
        },
        {
          "type": "richtext",
          "id": "notes",
          "label": "Fragrance notes"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Exclusive aroma oils"
    }
  ]
}
{% endschema %}

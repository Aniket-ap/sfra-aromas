<section class="section bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    <div class="contact">
      <div class="contact__info">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="contact__title">{{ section.settings.heading }}</h2>{%- endif -%}
        {%- if section.settings.text != blank -%}<p class="contact__intro">{{ section.settings.text }}</p>{%- endif -%}

        <ul class="contact__list">
          {%- for block in section.blocks -%}
            <li class="contact__item" {{ block.shopify_attributes }}>
              <span class="contact__icon">{% render 'icon', name: block.settings.icon, size: 20 %}</span>
              <div>
                {%- if block.settings.title != blank -%}<p class="contact__item-title">{{ block.settings.title }}</p>{%- endif -%}
                <div class="rte contact__item-text">{{ block.settings.text }}</div>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="contact__form-wrap">
        {%- form 'contact', id: 'ContactForm', class: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-message form-message--success" role="status" tabindex="-1" data-contact-feedback>{{ section.settings.success_message | escape }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="form-message form-message--error" role="alert" tabindex="-1" data-contact-feedback>
              <ul>
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          <div class="form-row">
            <div class="field">
              <label for="ContactName">Full name <span aria-hidden="true">*</span></label>
              <input type="text" id="ContactName" name="contact[name]" value="{{ form.name | escape }}" autocomplete="name" required>
            </div>
            <div class="field">
              <label for="ContactEmail">Email <span aria-hidden="true">*</span></label>
              <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required>
            </div>
          </div>

          <div class="field">
            <label for="ContactPhone">Phone</label>
            <input type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone | escape }}" autocomplete="tel">
          </div>

          <div class="form-row contact-form__choices">
          <div data-contact-choice>
            <div class="field">
              <label for="ContactBrand-{{ section.id }}">{{ section.settings.brand_label }}</label>
              <div class="select-wrap">
                <select id="ContactBrand-{{ section.id }}" name="contact[Brand inspiration]" data-contact-choice-select aria-controls="ContactBrandOtherField-{{ section.id }}">
                  <option value="">Select an option</option>
                  {%- assign options = section.settings.brand_options | newline_to_br | split: '<br />' -%}
                  {%- assign options = options | uniq -%}
                  {%- for option in options -%}
                    {%- assign option_label = option | strip -%}
                    {%- assign normalized_option = option_label | downcase -%}
                    {%- if option_label != blank and normalized_option != 'other' and normalized_option != 'others' -%}
                      <option value="{{ option_label | escape }}">{{ option_label | escape }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                  <option value="Other">Other</option>
                </select>
                {% render 'icon', name: 'chevron-down', size: 16 %}
              </div>
            </div>
            <div class="field" id="ContactBrandOtherField-{{ section.id }}" data-contact-choice-other>
              <label for="ContactBrandOther-{{ section.id }}">Other brand inspiration</label>
              <input type="text" id="ContactBrandOther-{{ section.id }}" name="contact[Other brand inspiration]" maxlength="120" placeholder="Please specify">
            </div>
          </div>

          <div data-contact-choice>
            <div class="field">
              <label for="ContactPerfume-{{ section.id }}">{{ section.settings.perfume_label }}</label>
              <div class="select-wrap">
                <select id="ContactPerfume-{{ section.id }}" name="contact[Perfume name]" data-contact-choice-select aria-controls="ContactPerfumeOtherField-{{ section.id }}">
                  <option value="">Select an option</option>
                  {%- assign options = section.settings.perfume_options | newline_to_br | split: '<br />' -%}
                  {%- assign options = options | uniq -%}
                  {%- for option in options -%}
                    {%- assign option_label = option | strip -%}
                    {%- assign normalized_option = option_label | downcase -%}
                    {%- if option_label != blank and normalized_option != 'other' and normalized_option != 'others' -%}
                      <option value="{{ option_label | escape }}">{{ option_label | escape }}</option>
                    {%- endif -%}
                  {%- endfor -%}
                  <option value="Other">Other</option>
                </select>
                {% render 'icon', name: 'chevron-down', size: 16 %}
              </div>
            </div>
            <div class="field" id="ContactPerfumeOtherField-{{ section.id }}" data-contact-choice-other>
              <label for="ContactPerfumeOther-{{ section.id }}">Other perfume name</label>
              <input type="text" id="ContactPerfumeOther-{{ section.id }}" name="contact[Other perfume name]" maxlength="120" placeholder="Please specify">
            </div>
          </div>

          </div>

          <div class="field">
            <label for="ContactMessage">{{ section.settings.message_label }}</label>
            <textarea id="ContactMessage" name="contact[body]" rows="5" maxlength="{{ section.settings.message_limit }}" data-counter-input placeholder="{{ section.settings.message_placeholder | escape }}">{{ form.body | escape }}</textarea>
            <p class="field__counter"><span data-counter>0</span> / {{ section.settings.message_limit }}</p>
          </div>

          <button type="submit" class="btn btn--solid">{{ section.settings.button_label }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>


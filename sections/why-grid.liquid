<section class="section bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  <div class="container">
    {% render 'section-heading', eyebrow: section.settings.eyebrow, heading: section.settings.heading, text: section.settings.subheading, align: 'center' %}
    {%- if section.settings.show_divider -%}<hr class="section-divider">{%- endif -%}

    <div class="card-grid card-grid--top" style="--cols: {{ section.settings.columns }};">
      {%- for block in section.blocks -%}
        <div class="info-card" {{ block.shopify_attributes }}>
          {%- if section.settings.show_numbers -%}
            <span class="info-card__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}<h3 class="info-card__title">{{ block.settings.title }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="info-card__text">{{ block.settings.text }}</p>{%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Numbered cards (Why us)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "The SFRA Advantage" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why SFRA Aromas" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Engineered purity and cold-air nebulization trusted by luxury hospitality and commercial environments." },
    { "type": "checkbox", "id": "show_divider", "label": "Show divider line", "default": true },
    { "type": "checkbox", "id": "show_numbers", "label": "Show numbers (01, 02…)", "default": true },
    { "type": "select", "id": "columns", "label": "Columns (desktop)", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "3" },
    { "type": "header", "content": "Section style" },
    { "type": "select", "id": "background", "label": "Background", "options": [
      { "value": "default", "label": "White" },
      { "value": "alt", "label": "Light gray" },
      { "value": "dark", "label": "Black" }
    ], "default": "alt" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 72 }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Card title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this point in a sentence or two." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Numbered cards (Why us)",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}

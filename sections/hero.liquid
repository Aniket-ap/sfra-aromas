<section class="hero hero--{{ section.settings.height }}" data-hero data-autoplay="{{ section.settings.autoplay }}" data-delay="{{ section.settings.delay }}">
  <div class="hero__track">
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign has_content = false
        if b.eyebrow != blank or b.heading != blank or b.text != blank or b.button_label != blank or b.button_label_2 != blank
          assign has_content = true
        endif
        assign show_overlay = false
        if has_content and b.overlay_opacity > 0
          assign show_overlay = true
        endif
        assign loading = 'lazy'
        if forloop.first
          assign loading = 'eager'
        endif
      -%}
      <div data-block-id="{{ block.id }}" class="hero__slide{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}
        style="--hero-text: {{ b.text_color }}; --hero-heading-size: {{ b.heading_size }}px; --hero-content-width: {{ b.content_width }}px; --hero-mobile-height: {{ b.small_height }}px;">
        <div class="hero__media">
          {%- if b.image != blank -%}
            <picture>
              {%- if b.image_small != blank -%}
                <source media="(max-width: 749px)" srcset="{{ b.image_small | image_url: width: 750 }} 750w, {{ b.image_small | image_url: width: 1100 }} 1100w" sizes="100vw">
              {%- endif -%}
              {%- assign img_alt = b.image.alt | default: b.heading -%}{{ b.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: loading, class: 'hero__img', alt: img_alt }}
            </picture>
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg hero__img' }}
          {%- endif -%}
          {%- if show_overlay -%}
            <div class="hero__overlay" style="background: {{ b.overlay_color }}; opacity: {{ b.overlay_opacity | divided_by: 100.0 }};"></div>
          {%- endif -%}
        </div>

        {%- if has_content -%}
          <div class="hero__inner container hero__inner--{{ b.align_horizontal }} hero__inner--v-{{ b.align_vertical }}">
            <div class="hero__content hero__content--{{ b.text_align }}">
              {%- if b.eyebrow != blank -%}<p class="eyebrow hero__eyebrow">{{ b.eyebrow }}</p>{%- endif -%}
              {%- if b.heading != blank -%}
                {%- if forloop.first -%}<h1 class="hero__heading">{{ b.heading }}</h1>{%- else -%}<h2 class="hero__heading">{{ b.heading }}</h2>{%- endif -%}
              {%- endif -%}
              {%- if b.text != blank -%}<p class="hero__text">{{ b.text }}</p>{%- endif -%}
              {%- if b.button_label != blank or b.button_label_2 != blank -%}
                <div class="hero__buttons">
                  {%- if b.button_label != blank -%}
                    <a href="{{ b.button_link | default: '#' }}" class="btn btn--{{ b.button_style }}">{{ b.button_label }}</a>
                  {%- endif -%}
                  {%- if b.button_label_2 != blank -%}
                    <a href="{{ b.button_link_2 | default: '#' }}" class="btn btn--{{ b.button_style_2 }}">{{ b.button_label_2 }}</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    {%- if section.settings.show_arrows -%}
      <button type="button" class="hero__arrow hero__arrow--prev" aria-label="Previous slide" data-hero-prev>{% render 'icon', name: 'arrow', size: 22 %}</button>
      <button type="button" class="hero__arrow hero__arrow--next" aria-label="Next slide" data-hero-next>{% render 'icon', name: 'arrow', size: 22 %}</button>
    {%- endif -%}
    {%- if section.settings.show_dots -%}
      <div class="hero__dots">
        {%- for block in section.blocks -%}
          <button type="button" class="hero__dot{% if forloop.first %} is-active{% endif %}" aria-label="Slide {{ forloop.index }}" data-hero-dot="{{ forloop.index0 }}"></button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero banner",
  "settings": [
    {
      "type": "select",
      "id": "height",
      "label": "Desktop height",
      "options": [
        {
          "value": "small",
          "label": "Small (50% of screen)"
        },
        {
          "value": "medium",
          "label": "Medium (70% of screen)"
        },
        {
          "value": "large",
          "label": "Large (85% of screen)"
        },
        {
          "value": "full",
          "label": "Full screen"
        }
      ],
      "default": "large"
    },
    {
      "type": "header",
      "content": "Slideshow"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Auto-rotate slides",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Change slides every",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show dots",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "header",
          "content": "Images"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Banner image (desktop)",
          "info": "Recommended 2400 x 1100px"
        },
        {
          "type": "image_picker",
          "id": "image_small",
          "label": "Banner image (mobile, optional)",
          "info": "Recommended 900 x 1200px"
        },
        {
          "type": "range",
          "id": "small_height",
          "min": 320,
          "max": 800,
          "step": 20,
          "unit": "px",
          "label": "Mobile height",
          "default": 520
        },
        {
          "type": "header",
          "content": "Content (leave empty for an image-only banner)"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Small heading"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Subheading / text"
        },
        {
          "type": "range",
          "id": "heading_size",
          "min": 24,
          "max": 96,
          "step": 2,
          "unit": "px",
          "label": "Heading size",
          "default": 56
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text color",
          "default": "#ffffff"
        },
        {
          "type": "header",
          "content": "Button 1"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Style",
          "options": [
            {
              "value": "light",
              "label": "Solid white"
            },
            {
              "value": "solid",
              "label": "Solid black"
            },
            {
              "value": "outline-light",
              "label": "Outline white"
            }
          ],
          "default": "light"
        },
        {
          "type": "header",
          "content": "Button 2"
        },
        {
          "type": "text",
          "id": "button_label_2",
          "label": "Label"
        },
        {
          "type": "url",
          "id": "button_link_2",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "button_style_2",
          "label": "Style",
          "options": [
            {
              "value": "light",
              "label": "Solid white"
            },
            {
              "value": "solid",
              "label": "Solid black"
            },
            {
              "value": "outline-light",
              "label": "Outline white"
            }
          ],
          "default": "outline-light"
        },
        {
          "type": "header",
          "content": "Content position"
        },
        {
          "type": "select",
          "id": "align_horizontal",
          "label": "Horizontal position",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "select",
          "id": "align_vertical",
          "label": "Vertical position",
          "options": [
            {
              "value": "top",
              "label": "Top"
            },
            {
              "value": "middle",
              "label": "Middle"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            }
          ],
          "default": "middle"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text alignment",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "left"
        },
        {
          "type": "range",
          "id": "content_width",
          "min": 360,
          "max": 900,
          "step": 20,
          "unit": "px",
          "label": "Content width",
          "default": 620
        },
        {
          "type": "header",
          "content": "Dark overlay"
        },
        {
          "type": "paragraph",
          "content": "The overlay is applied automatically only when this slide has text or buttons. Image-only banners stay clean."
        },
        {
          "type": "color",
          "id": "overlay_color",
          "label": "Overlay color",
          "default": "#000000"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 90,
          "step": 5,
          "unit": "%",
          "label": "Overlay opacity",
          "default": 40
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero banner",
      "blocks": [
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}

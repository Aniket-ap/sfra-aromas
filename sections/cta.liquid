<section class="section cta bg-{{ section.settings.background }}" style="--pt: {{ section.settings.padding_top }}px; --pb: {{ section.settings.padding_bottom }}px;">
  {%- if section.settings.image != blank -%}
    <div class="cta__bg">
      {{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'lazy', widths: '750, 1100, 1500, 2000', sizes: '100vw', alt: '' }}
      <div class="cta__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};"></div>
    </div>
  {%- endif -%}
  <div class="container cta__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="cta__title">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<div class="cta__text">{{ section.settings.text }}</div>{%- endif -%}
    {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
      <div class="cta__buttons">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--light">{{ section.settings.button_label }}</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: '#' }}" class="btn btn--outline-light">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.tagline != blank -%}<p class="cta__tagline">{{ section.settings.tagline }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Call to action",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Tailored Scent Solutions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get Started" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Whether you're outfitting a single boutique or scenting an entire hotel chain, SFRA Aromas offers tailored diffusion solutions and fragrance consultations to match your space and brand identity." },
    { "type": "text", "id": "button_label", "label": "Button 1 label", "default": "Schedule a Fragrance Consultation" },
    { "type": "url", "id": "button_link", "label": "Button 1 link" },
    { "type": "text", "id": "button_label_2", "label": "Button 2 label", "default": "Browse Our Catalogue" },
    { "type": "url", "id": "button_link_2", "label": "Button 2 link" },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "SFRA Aromas — Pure Scent. Pure Air. Pure Confidence." },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "image", "label": "Background image (optional)" },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 90, "step": 5, "unit": "%", "label": "Image overlay opacity", "default": 60 },
    { "type": "select", "id": "background", "label": "Background color", "options": [
      { "value": "dark", "label": "Black" },
      { "value": "alt", "label": "Light gray" },
      { "value": "default", "label": "White" }
    ], "default": "dark" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Top padding", "default": 96 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Bottom padding", "default": 96 }
  ],
  "presets": [{ "name": "Call to action" }]
}
{% endschema %}

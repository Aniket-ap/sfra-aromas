{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="section product" style="--pt: 48px; --pb: 72px;" data-product>
  <div class="container">
    <div class="product__layout">
      {%- liquid
        assign product_images = product.media | where: 'media_type', 'image'
        assign active_media = current_variant.featured_media
        unless active_media.media_type == 'image'
          assign active_media = product_images.first
        endunless
      -%}
      <div class="product__gallery">
        <div class="product__main" data-main-image>
          {%- for media in product_images -%}
            {%- liquid
              assign image_loading = 'lazy'
              if media.id == active_media.id
                assign image_loading = 'eager'
              endif
              assign img_alt = media.alt | default: product.title
            -%}
            <div class="product__slide{% if media.id == active_media.id %} is-active{% endif %}" data-media-id="{{ media.id }}">
              {{ media | image_url: width: 1400 | image_tag: loading: image_loading, widths: '360, 500, 800, 1100, 1400', sizes: '(min-width: 990px) 480px, (min-width: 750px) 480px, 100vw', alt: img_alt }}
            </div>
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endfor -%}
        </div>
        {%- if product_images.size > 1 -%}
          <ul class="product__thumbs">
            {%- for media in product_images -%}
              <li>
                <button type="button" class="product__thumb{% if media.id == active_media.id %} is-active{% endif %}" data-thumb="{{ media.id }}" aria-label="Image {{ forloop.index }}">
                  {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- if product.vendor != blank -%}<p class="eyebrow">{{ product.vendor }}</p>{%- endif -%}
        <h1 class="product__title">{{ product.title }}</h1>

        <p class="product__price" data-price>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s>{{ current_variant.compare_at_price | money }}</s>
          {%- endif -%}
          <span>{{ current_variant.price | money }}</span>
        </p>

        {%- liquid
          assign show_price_note = false
          if section.settings.price_note_scope == 'all'
            assign show_price_note = true
          elsif section.settings.price_note_scope == 'collection' and section.settings.price_note_collection != blank
            for product_collection in product.collections
              if product_collection.id == section.settings.price_note_collection.id
                assign show_price_note = true
                break
              endif
            endfor
          endif
        -%}
        {%- if show_price_note and section.settings.price_note != blank -%}
          <p class="product__price-note">{{ section.settings.price_note | escape }}</p>
        {%- endif -%}

        {%- form 'product', product, class: 'product-form', id: 'ProductForm' -%}
          {{ form.errors | default_errors }}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="field">
                <label for="Option{{ forloop.index0 }}">{{ option.name }}</label>
                <div class="select-wrap">
                  <select id="Option{{ forloop.index0 }}" data-option-index="{{ forloop.index0 }}">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                  {% render 'icon', name: 'chevron-down', size: 16 %}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <div class="field field--qty">
            <label for="Quantity">Quantity</label>
            <div class="quantity-control" data-quantity-control>
              <button type="button" aria-label="Decrease quantity" data-quantity-minus><i class="bi bi-dash-lg" aria-hidden="true"></i></button>
              <input type="number" id="Quantity" name="quantity" value="{{ current_variant.quantity_rule.min }}" min="{{ current_variant.quantity_rule.min }}" step="{{ current_variant.quantity_rule.increment }}"{% if current_variant.quantity_rule.max %} max="{{ current_variant.quantity_rule.max }}"{% endif %} inputmode="numeric" data-quantity-input>
              <button type="button" aria-label="Increase quantity" data-quantity-plus><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
            </div>
          </div>

          <div class="product__actions">
            <button type="submit" name="add" class="btn btn--solid" data-add-btn{% unless current_variant.available %} disabled{% endunless %}>
              {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
            </button>
            <button type="submit" name="return_to" value="{{ routes.root_url }}checkout" class="btn btn--outline product__buy-now" data-buy-now{% unless current_variant.available %} hidden disabled{% endunless %}>Buy now</button>
          </div>
        {%- endform -%}

        {%- if product.description != blank -%}
          <div class="product__description rte">{{ product.description }}</div>
        {%- endif -%}
        {% render 'product-benefits', product: product, section: section %}
        {% render 'product-details', product: product, section: section %}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
  <script type="application/json" data-variant-prices>
    {
      {%- for v in product.variants -%}
        "{{ v.id }}": {
          "price": {{ v.price | money | json }},
          "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}""{% endif %},
          "available": {{ v.available | json }},
          "quantity_min": {{ v.quantity_rule.min | default: 1 | json }},
          "quantity_step": {{ v.quantity_rule.increment | default: 1 | json }},
          "quantity_max": {{ v.quantity_rule.max | json }},
          "media": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "select",
      "id": "price_note_scope",
      "label": "Tax and shipping note visibility",
      "options": [
        {
          "value": "off",
          "label": "Hidden"
        },
        {
          "value": "collection",
          "label": "Selected collection only"
        },
        {
          "value": "all",
          "label": "All products"
        }
      ],
      "default": "collection"
    },
    {
      "type": "collection",
      "id": "price_note_collection",
      "label": "Collection for tax and shipping note",
      "info": "Choose your Aroma Diffusers collection. The note appears only on products in that collection."
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "Text below price",
      "default": "Tax included. Free shipping."
    },
    {
      "type": "header",
      "content": "Product details accordions"
    },
    {
      "type": "checkbox",
      "id": "show_product_details",
      "label": "Show product details accordions",
      "default": true
    },
    {
      "type": "text",
      "id": "details_heading",
      "label": "Details heading",
      "default": "Product details"
    },
    {
      "type": "text",
      "id": "specifications_label",
      "label": "Specifications label",
      "default": "Specifications"
    },
    {
      "type": "text",
      "id": "box_label",
      "label": "Box contents label",
      "default": "What?s in the box"
    },
    {
      "type": "checkbox",
      "id": "details_open_first",
      "label": "Open first accordion initially",
      "default": false
    },
    {
      "type": "paragraph",
      "content": "Product rich text metafields custom.specifications and custom.whats_in_the_box override matching Product details blocks. Empty accordions are hidden."
    },
    {
      "type": "header",
      "content": "Diffuser benefits"
    },
    {
      "type": "checkbox",
      "id": "show_product_benefits",
      "label": "Show benefits row",
      "default": true
    },
    {
      "type": "collection",
      "id": "benefits_collection",
      "label": "Diffuser collection",
      "info": "Benefits appear only for products in this collection. Select your Aroma Diffusers collection to enable the row."
    },
    {
      "type": "range",
      "id": "benefits_icon_size",
      "label": "Icon size",
      "min": 24,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "product_details",
      "name": "Product details",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Choose an exact product, or use title keywords below."
        },
        {
          "type": "text",
          "id": "title_keywords",
          "label": "Product title keywords",
          "info": "Comma-separated model names. Matches whole words; ignored when a product is selected."
        },
        {
          "type": "richtext",
          "id": "specifications",
          "label": "Specifications"
        },
        {
          "type": "richtext",
          "id": "box_contents",
          "label": "What?s in the box"
        }
      ]
    },
    {
      "type": "benefit",
      "name": "Product benefit",
      "limit": 4,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon image",
          "info": "A small square image with a transparent background works best."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Fallback icon",
          "options": [
            {
              "value": "truck",
              "label": "Shipping"
            },
            {
              "value": "shield",
              "label": "Warranty"
            },
            {
              "value": "headset",
              "label": "Customer service"
            },
            {
              "value": "monitor",
              "label": "Demo"
            }
          ],
          "default": "shield"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Product benefit"
        }
      ]
    }
  ]
}
{% endschema %}

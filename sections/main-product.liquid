{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="section product" style="--pt: 48px; --pb: 72px;" data-product>
  <div class="container">
    <div class="product__layout">
      {%- liquid
        assign product_images = product.media | where: 'media_type', 'image'
        assign active_media = current_variant.featured_media
        unless active_media.media_type == 'image'
          assign active_media = product_images.first
        endunless
      -%}
      <div class="product__gallery">
        <div class="product__main" data-main-image>
          {%- for media in product_images -%}
            {%- liquid
              assign image_loading = 'lazy'
              if media.id == active_media.id
                assign image_loading = 'eager'
              endif
              assign img_alt = media.alt | default: product.title
            -%}
            <div class="product__slide{% if media.id == active_media.id %} is-active{% endif %}" data-media-id="{{ media.id }}">
              {{ media | image_url: width: 1400 | image_tag: loading: image_loading, widths: '360, 500, 800, 1100, 1400', sizes: '(min-width: 990px) 480px, (min-width: 750px) 480px, 100vw', alt: img_alt }}
            </div>
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endfor -%}
        </div>
        {%- if product_images.size > 1 -%}
          <ul class="product__thumbs">
            {%- for media in product_images -%}
              <li>
                <button type="button" class="product__thumb{% if media.id == active_media.id %} is-active{% endif %}" data-thumb="{{ media.id }}" aria-label="Image {{ forloop.index }}">
                  {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="product__info">
        {%- if product.vendor != blank -%}<p class="eyebrow">{{ product.vendor }}</p>{%- endif -%}
        <h1 class="product__title">{{ product.title }}</h1>

        <p class="product__price" data-price>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <s>{{ current_variant.compare_at_price | money }}</s>
          {%- endif -%}
          <span>{{ current_variant.price | money }}</span>
        </p>

        {%- form 'product', product, class: 'product-form', id: 'ProductForm' -%}
          {{ form.errors | default_errors }}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="field">
                <label for="Option{{ forloop.index0 }}">{{ option.name }}</label>
                <div class="select-wrap">
                  <select id="Option{{ forloop.index0 }}" data-option-index="{{ forloop.index0 }}">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}"{% if option.selected_value == value %} selected{% endif %}>{{ value }}</option>
                    {%- endfor -%}
                  </select>
                  {% render 'icon', name: 'chevron-down', size: 16 %}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <div class="field field--qty">
            <label for="Quantity">Quantity</label>
            <div class="quantity-control" data-quantity-control>
              <button type="button" aria-label="Decrease quantity" data-quantity-minus><i class="bi bi-dash-lg" aria-hidden="true"></i></button>
              <input type="number" id="Quantity" name="quantity" value="{{ current_variant.quantity_rule.min }}" min="{{ current_variant.quantity_rule.min }}" step="{{ current_variant.quantity_rule.increment }}"{% if current_variant.quantity_rule.max %} max="{{ current_variant.quantity_rule.max }}"{% endif %} inputmode="numeric" data-quantity-input>
              <button type="button" aria-label="Increase quantity" data-quantity-plus><i class="bi bi-plus-lg" aria-hidden="true"></i></button>
            </div>
          </div>

          <div class="product__actions">
            <button type="submit" name="add" class="btn btn--solid" data-add-btn{% unless current_variant.available %} disabled{% endunless %}>
              {%- if current_variant.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
            </button>
            <button type="submit" name="return_to" value="{{ routes.root_url }}checkout" class="btn btn--outline product__buy-now" data-buy-now{% unless current_variant.available %} hidden disabled{% endunless %}>Buy now</button>
          </div>
        {%- endform -%}

        {%- if product.description != blank -%}
          <div class="product__description rte">{{ product.description }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>{{ product | json }}</script>
  <script type="application/json" data-variant-prices>
    {
      {%- for v in product.variants -%}
        "{{ v.id }}": {
          "price": {{ v.price | money | json }},
          "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}""{% endif %},
          "available": {{ v.available | json }},
          "quantity_min": {{ v.quantity_rule.min | default: 1 | json }},
          "quantity_step": {{ v.quantity_rule.increment | default: 1 | json }},
          "quantity_max": {{ v.quantity_rule.max | json }},
          "media": {% if v.featured_media %}{{ v.featured_media.id }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    }
  </script>
</section>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
